# Server
NODE_ENV=development
PORT=5000

# Email verification, password-reset aur Stripe redirect links isi base par bante hain
FRONTEND_URL=http://localhost:5173

# Comma-separated list of frontend origins allowed to call this API (CORS +
# Socket.IO). Not set = falls back to local dev ports (5173 customer, 5174 admin).
# Production: https://your-customer.onrender.com,https://your-admin.onrender.com
CORS_ORIGINS=

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Auth — apni unique key banayen: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# SMTP (optional). Na hon to backend console par verification/reset link print
# ho jata hai — local testing ke liye kaafi hai.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Cloudinary — HAR image upload yahan jata hai (products, categories, /api/media).
# Local disk par kuch save nahi hota, warna Render par har restart ke sath images
# ur jatin. Ye keys na hon to server chalta to hai, magar upload fail karta hai.
# Free account: https://cloudinary.com/users/register_free (Dashboard par teeno values)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (optional). Ye khali hon to card payments band rehte hain
# (/api/payments/config batata hai, aur checkout par Card option disabled hota hai).
# Test keys yahan se: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secret `stripe listen` chalane par milta hai — neeche README dekhen
STRIPE_WEBHOOK_SECRET=
